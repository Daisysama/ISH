# 复制成 .env 后使用。scripts\setup.ps1 会自动生成一份。

# 项目自带的本地 PostgreSQL（setup.ps1 建的，端口 15432）
DATABASE_URL="postgresql://ish:ish_dev_password@127.0.0.1:15432/ish"

# 会话 cookie 的签名密钥，至少 32 位。
# 每个环境都应该不一样，绝对不要提交到版本库。
# 生成一个：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="换成你自己的随机字符串至少三十二位以上"

# 首次注册站主账号后，在“我的画像 → 站主首次配置所需的内部编号”复制 UUID。
# 此处必须是内部 users.id，不是公开短 UID。配置后重启服务。
# 管理员由站主在“治理 → 网站管理员”中按账号授权；邮箱不授予管理权限。
SITE_OWNER_USER_ID=""

# 公开站点地址，用于 canonical / Open Graph / sitemap。
NEXT_PUBLIC_SITE_URL="https://fromish.com"
