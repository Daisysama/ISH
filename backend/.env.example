# 复制成 backend\.env 后按需修改。不复制也能跑——下面这些就是代码里的默认值。

# 项目自带的本地集群（scripts\setup.ps1 建的，端口 55432）
ISH_DATABASE_URL=postgresql+psycopg://ish:ish_dev_password@127.0.0.1:55432/ish
ISH_TEST_DATABASE_URL=postgresql+psycopg://ish:ish_dev_password@127.0.0.1:55432/ish_test

# 想连自己已有的 PostgreSQL，改成类似这样：
# ISH_DATABASE_URL=postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/ish
# ISH_TEST_DATABASE_URL=postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/ish_test

# 本地开发用的签名密钥。真上线必须换成随机长串。
ISH_JWT_SECRET=dev-only-secret-change-in-production

# 前端地址，用于 CORS
ISH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
