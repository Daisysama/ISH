// ISH 数据库结构定义。
//
// v0.2 起进入可审计 migration 工作流：
//   - 开发环境：npx prisma migrate dev
//   - 生产环境：npx prisma migrate deploy
// 不再使用 db push 直接修改生产结构。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 用户账号。
model User {
  id String @id @default(uuid())

  /// 登录用的邮箱。统一转成小写后存储，避免 Alice@x.com 和 alice@x.com 被当成两个人。
  email String @unique

  /// 显示名称。会出现在界面上，可以重复。
  displayName String

  /// bcrypt 哈希后的密码。数据库里永远不存明文。
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects  Project[]                @relation("ProjectCreator")
  moderationEvents ProjectModerationEvent[] @relation("ProjectModerator")

  @@map("users")
}

/// “咩”从提交到公开的最小治理状态机。
enum ProjectStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// 项目本身的成长阶段，与平台审核状态分离。
enum ProjectStage {
  IDEA
  WRITING
  CONCEPT
  PROTOTYPE
  DEMO
  DEVELOPING
  TEAM
}

/// 审核事件只追加不覆盖，用于保留治理动作历史。
enum ModerationAction {
  APPROVED
  REJECTED
}

model Project {
  id String @id @default(uuid())

  creatorId String
  creator   User   @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  title       String
  summary     String
  description String? @db.Text

  /// 面向玩家和同行者展示的结构化信息。
  stage       ProjectStage @default(IDEA)
  typeTags    String[]     @default([])
  seekingTags String[]     @default([])
  platforms   String[]     @default([])
  externalUrl String?

  /// 群聊信息默认仅创作者与 ISH 管理员可见，不进入公开卡片。
  groupType         String?
  groupContact      String? @db.Text
  allowIshJoinGroup Boolean @default(false)

  status          ProjectStatus @default(PENDING)
  rejectionReason String?       @db.Text

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  moderationEvents ProjectModerationEvent[]

  @@index([status, submittedAt])
  @@index([creatorId, createdAt])
  @@map("projects")
}

model ProjectModerationEvent {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  moderatorId String?
  moderator   User?   @relation("ProjectModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  action ModerationAction
  note   String?          @db.Text

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([moderatorId, createdAt])
  @@map("project_moderation_events")
}
